# -----------------------------------------------------------------------------
# Jarvis / WeedEater Lawn Care — environment configuration
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# -----------------------------------------------------------------------------

# Required — Supabase (public/browser-safe values only; no service-role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional — AI Advisor (server-only; used by src/app/api/ai-advisor/route.ts)
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=claude-sonnet-5

# Optional — Homeworks (server-only)
HOMEWORKS_API_KEY=

# Optional — QuickBooks OAuth (server-only)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Optional — Zapier (server-only)
ZAPIER_WEBHOOK_URL=

# Optional — Google Calendar OAuth (server-only)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional — Weather (server-only). Uses the National Weather Service
# (api.weather.gov) — free, US-only, no API key needed. Just set your shop's
# dispatch coordinates and the Command Center weather card goes live.
WEATHER_LOCATION_LAT=
WEATHER_LOCATION_LON=

# Optional — GitHub (server-only, for future CI/deploy integrations)
GITHUB_TOKEN=
